# O SGBI v2 roda em modo conceito (D47): os dados são simulados (Mercado Teste) e
# nenhuma variável é obrigatória. Todas abaixo são opcionais.

# Assina o cookie de sessão do login (mínimo 32 caracteres, ex.: openssl rand -base64 32).
# Sem ela, usa um segredo fixo de demonstração.
JWT_SECRET=""

# Identifica a instalação quando há mais de um SGBI no mesmo endereço
# (ex.: portas diferentes no mesmo servidor), para cada um ter o próprio cookie.
CLIENT_SLUG=""

# Para testes: força a plataforma (vx, cloud ou fivewin) e mostra os cards que
# ficam indisponíveis nela (D46).
PLATAFORMA=""
